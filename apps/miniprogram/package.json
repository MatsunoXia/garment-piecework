    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "vue3",
    "@dcloudio/uni-stacktracey": "vue3",
    "@dcloudio/vite-plugin-uni": "vue3",
    "@vue/tsconfig": "^0.5.1",
    "sass": "^1.77.8",
    "typescript": "~5.6.3",
    "vite": "5.2.8",
    "vue-tsc": "^2.1.10"
  }
}
