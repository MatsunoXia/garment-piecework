# ==== 服务 ====
PORT=3000
# production / development
NODE_ENV=development
# Web 管理后台允许的跨域来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ==== 数据库 ====
# PostgreSQL 连接串（替换为你的实际地址/账号/密码/库名）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garment_piecework?schema=public"

# ==== 认证 ====
# JWT 签名密钥（必填）：请使用足够长的随机字符串，例如 `openssl rand -base64 48`
JWT_SECRET=please-generate-a-long-random-secret
# 访问令牌有效期
JWT_EXPIRES_IN=7d

# ==== 微信小程序 ====
# 微信小程序 AppID / AppSecret（必填，用于 code2session 登录）
# 兼容两种变量名：WECHAT_MINIPROGRAM_APPID / WECHAT_MINI_APP_ID
WECHAT_MINIPROGRAM_APPID=wx0000000000000000
WECHAT_MINIPROGRAM_SECRET=please-fill-your-wechat-appsecret

# ==== 本地开发 ====
# 是否开启 POST /api/auth/dev/login（直接用 OpenID 登录，跳过微信 code2session）。
# 仅用于本地联调，生产环境必须保持 false
ENABLE_DEV_LOGIN=false

# ==== NestJS Observe（可选）====
# 未配置时应用不发送遥测数据
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
